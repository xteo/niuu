# Public builds use an allowlist. Never send a checkout's Git metadata, local
# configuration, credentials, workspaces, captures or reports to the builder.
**
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!src/
!src/**
!migrations/
!migrations/**
!containers/
!containers/**
!web-next/
!web-next/**
!web/
!web/**
!scripts/
!scripts/build_manifest.py

**/.git
**/.env
**/.env.*
**/.npmrc
**/.netrc
