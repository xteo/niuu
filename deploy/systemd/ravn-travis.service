[Unit]
Description=Ravn Travis (Telegram + local HTTP + OpenClaw shim for LexiChat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd --user starts with a minimal PATH that does not include ~/.local/bin,
# so `uv` is not found and the unit dies with status=127 before it logs anything.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.ravn/start-travis.sh
# Restart the gateway if it exits unexpectedly.
Restart=always
RestartSec=5
StandardOutput=append:%h/.ravn/travis.log
StandardError=append:%h/.ravn/travis.log
# Ravn keeps sessions in RAM; a hard kill loses conversation context, so give it
# a chance to finish an in-flight turn.
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
